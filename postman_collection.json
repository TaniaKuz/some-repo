{
  "info": {
    "name": "Flower Shop API",
    "description": "A simple flower shop REST API (flowers + orders) backed by an in-memory store.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "flowerId",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        }
      ]
    },
    {
      "name": "Flowers",
      "item": [
        {
          "name": "List flowers",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/flowers?color=red&inStock=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "flowers"],
              "query": [
                { "key": "color", "value": "red" },
                { "key": "inStock", "value": "true" }
              ]
            }
          }
        },
        {
          "name": "Get flower by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/flowers/{{flowerId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "flowers", "{{flowerId}}"]
            }
          }
        },
        {
          "name": "Create flower",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Orchid\",\n  \"color\": \"purple\",\n  \"priceCents\": 900,\n  \"stock\": 15\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/flowers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "flowers"]
            }
          }
        },
        {
          "name": "Update flower",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"priceCents\": 999,\n  \"stock\": 50\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/flowers/{{flowerId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "flowers", "{{flowerId}}"]
            }
          }
        },
        {
          "name": "Delete flower",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/flowers/{{flowerId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "flowers", "{{flowerId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Place order",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    { \"flowerId\": \"{{flowerId}}\", \"quantity\": 2 }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders"]
            }
          }
        },
        {
          "name": "List orders",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders"]
            }
          }
        },
        {
          "name": "Get order by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{orderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders", "{{orderId}}"]
            }
          }
        },
        {
          "name": "Cancel order",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{orderId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders", "{{orderId}}", "cancel"]
            }
          }
        }
      ]
    }
  ]
}
